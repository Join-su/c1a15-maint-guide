# 복사해서 .env로 쓰고 값을 채운다(.env는 Git에 넣지 않는다). 값은 여기에 적지 않는다.
POSTGRES_PASSWORD=
C1A15_TECH_PASSWORD=
C1A15_LEAD_PASSWORD=
C1A15_INTERNAL_TOKEN=
APP_MODE=fixture
DB_HOST_PORT=55432
# 배포 서버(EV-001 CH-38): 컨테이너 앱 = http://<C1A15_DEPLOY_HOST>:<port> — 맥 host 직접 실행은 http://127.0.0.1:<port>
C1A15_DEPLOY_URL=
C1A15_DEPLOY_HOST=
C1A15_ALARM=boundary
C1A15_R12_INBOX=
# 사람 체크 기록(EV-006): off(기본) | deploy — 파트장 마지막 결정 뒤 배포 서버로 문서 한 장
C1A15_CHECKS=off
# VPS 덧파일(docker-compose.vps.yml)만 쓰는 바깥 주소 이름 — 값은 서버 .env에만
C1A15_TECH_HOST=
C1A15_LEAD_HOST=
C1A15_DEPLOY_NETWORK=
C1A15_R12_INBOX_HOST=
# 0009 운영 적용 때만 명령 앞에 붙여 씀 — .env에 남기지 않음(D-335): C1A15_ALLOW_0009=yes
