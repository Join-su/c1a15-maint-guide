{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Factory Run State",
  "type": "object",
  "required": ["run_id", "project_id", "skill_version", "work_type", "risk_level", "phase", "current_gate", "status", "artifacts", "next_action"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "factory_profile": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1},
        "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "work_type": {"enum": ["new_flow"]},
    "risk_level": {"enum": ["standard", "high"]},
    "phase": {"enum": ["prebuild", "prebuild_contract", "build", "verification"]},
    "current_gate": {"enum": ["G0", "G1", "G2A", "G2B", "G3", "PBC-0", "PBC-1", "PBC-2", "PBC-3", "PBC-4", "G4", "G5", "G6", "G7"]},
    "status": {"enum": ["draft", "awaiting_critic", "awaiting_human_gate", "approved", "blocked", "completed"]},
    "artifacts": {"type": "object"},
    "next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
